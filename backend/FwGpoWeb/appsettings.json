{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "AuthMode": "Windows",
    "Hosting": "Iis",
    "KestrelUrl": "https://0.0.0.0:8443",
    "SessionIdleMinutes": 30,
    "SessionAbsoluteHours": 8,
    "SessionCookieName": "FwGpo.Sid",
    "AdminGroups": [ "Domain Admins" ],
    "DataDir": "",
    "MockUser": "admin@corp.local",
    "MockIsAdmin": true
  },
  "Ad": {
    "Mock": false,
    "Domain": "",
    "DcEndpoint": "",
    "LdapPort": 389,
    "UseLdapSsl": false,
    "TimeoutSeconds": 10
  },
  "WebAuthn": {
    "RpId": "localhost",
    "RpName": "FW-GPO Builder",
    "Origins": [ "http://localhost:5000" ]
  },
  "Pwsh": {
    "Exe": "powershell.exe",
    "ModuleDir": "C:\\Program Files\\FwGpoWeb\\powershell\\FwGpoBuilder",
    "TimeoutSeconds": 300
  },
  "Security": {
    "MfaMaxAttempts": 5,
    "MfaLockoutMinutes": 15,
    "RateLimitPerMinute": 60
  }
}
